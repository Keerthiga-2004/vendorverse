# VendorVerse Backend — Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit .env to git

# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=

# JWT secret — use a long random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Cloudinary credentials — from cloudinary.com dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend URL — used to restrict CORS in production
# Set to your Vercel frontend URL after deploying
# Example: https://vendorverse.vercel.app
CLIENT_URL=

# Port (optional — defaults to 5000 locally, Render sets this automatically)
PORT=5000